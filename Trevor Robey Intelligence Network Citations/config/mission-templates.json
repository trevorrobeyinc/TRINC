    "pharmacovigilance_enterprise": {
      "id": "pharmacovigilance_enterprise",
      "enabled": true,
      "safety_class": "research_only",
      "spawned_roles": ["safety_signal_detector", "literature_reviewer", "quality_auditor", "report_generator"],
      "steps": [
        {
          "role": "safety_signal_detector",
          "action_type": "execute_tools",
          "task_type": "analyze",
          "description": "Detect disproportionality signals (PRR/ROR) from FAERS and safety databases",
          "input_strategy": "mission_inputs",
          "provider": "tooluniverse"
        },
        {
          "role": "literature_reviewer",
          "action_type": "collect_sources",

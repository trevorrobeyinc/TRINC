          "provider": "tooluniverse"
        },
        {
          "role": "quality_auditor",
          "action_type": "analyze_documents",
          "task_type": "analyze",
          "description": "Verify all safety claims against source databases and score confidence",
          "input_strategy": "dependency_outputs",

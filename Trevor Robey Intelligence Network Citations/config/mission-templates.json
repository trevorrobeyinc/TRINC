        {
          "role": "analyst",
          "action_type": "execute_tools",
          "task_type": "analyze",
          "description": "Execute molecular and target tools to gather pharmacological data",
          "input_strategy": "mission_and_dependency_outputs",
          "depends_on": [1],
          "provider": "tooluniverse"
        },
        {
          "role": "synthesizer",
          "action_type": "synthesize_output",
          "task_type": "synthesize",
          "description": "Synthesize findings into a drug discovery research pack",
          "input_strategy": "dependency_outputs",
          "depends_on": [2]
        }

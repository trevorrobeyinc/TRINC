    "drug_repurposing_deep": {
      "id": "drug_repurposing_deep",
      "enabled": true,
      "safety_class": "research_only",
      "spawned_roles": ["literature_reviewer", "molecular_profiler", "safety_signal_detector", "synthesizer"],
      "steps": [
        {
          "role": "literature_reviewer",

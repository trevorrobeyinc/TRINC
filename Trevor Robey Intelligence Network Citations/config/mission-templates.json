    "biomedical_drug_discovery": {
      "id": "biomedical_drug_discovery",
      "enabled": true,
      "safety_class": "research_only",
      "spawned_roles": ["scout", "analyst", "synthesizer"],
      "steps": [
        {
          "role": "scout",

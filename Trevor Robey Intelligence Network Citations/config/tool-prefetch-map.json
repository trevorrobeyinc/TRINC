{
  "schema_version": "tool-prefetch-map-v2",
  "role_mappings": {
    "scout": [
      {
        "action": "executeTool",
        "tool_name": "PubMed_search_articles",
        "arguments": {
          "query": "{{therapeutic_area}} {{indication}} {{compound_name}}",
          "limit": 8
        }
      },
      {
        "action": "executeTool",
        "tool_name": "SemanticScholar_search_papers",
        "arguments": {
          "query": "{{therapeutic_area}} {{indication}} {{compound_name}}",
          "limit": 8,
          "include_abstract": true
        }
      },
      {
        "action": "executeTool",
        "tool_name": "search_clinical_trials",
        "arguments": {
          "query_term": "{{therapeutic_area}} {{indication}} {{compound_name}}",
          "condition": "{{indication}}",
          "pageSize": 8
        }
      },
      {
        "action": "executeTool",
        "tool_name": "ctgov_stopped_trials",
        "optional": true,
        "arguments": {
          "condition": "{{indication}}",
          "pageSize": 6
        }
      },
      {
        "action": "executeTool",
        "tool_name": "OpenTargets_get_drug_id_description_by_name",
        "arguments": {
          "drugName": "{{compound_name}}"
        }
      },
      {
        "action": "executeTool",
        "tool_name": "obsidian_prior_research",
        "optional": true,
        "_comment": "Vault read-back via the canonical :8798 bridge. optional+fail-soft: when Obsidian is closed (e.g. run-workflow.js launched standalone) this yields nothing and the run proceeds with no prior-vault context.",
        "arguments": {
          "topic": "{{therapeutic_area}} {{indication}} {{compound_name}}",
          "limit": 5
        }
      }
    ],
    "analyst": [
      {
        "action": "executeTool",
        "tool_name": "EuropePMC_search_articles",
        "arguments": {
          "query": "{{compound_name}} {{indication}} mechanism",
          "limit": 6
        }
      },
      {
        "action": "executeTool",
        "tool_name": "SemanticScholar_search_papers",
        "arguments": {
          "query": "{{compound_name}} {{indication}} mechanism",
          "limit": 6,
          "include_abstract": true
        }
      },
      {
        "action": "executeTool",
        "tool_name": "FAERS_search_reports_by_drug_and_indication",
        "arguments": {
          "medicinalproduct": "{{compound_name}}",
          "drugindication": "{{indication}}",
          "limit": 5
        }
      },
      {
        "action": "executeTool",
        "tool_name": "search_clinical_trials",
        "arguments": {
          "query_term": "{{compound_name}} {{indication}} endpoints",
          "intervention": "{{compound_name}}",
          "pageSize": 6
        }
      }
    ],
    "synthesizer": [
      {
        "action": "executeTool",
        "tool_name": "PubMed_search_articles",
        "arguments": {
          "query": "{{therapeutic_area}} review {{indication}}",
          "limit": 5
        }
      }
    ],
    "safety_signal_detector": [
      {
        "action": "executeTool",
        "tool_name": "FAERS_search_reports_by_drug_and_indication",
        "arguments": {
          "medicinalproduct": "{{compound_name}}",
          "drugindication": "{{indication}}",
          "limit": 8
        }
      },
      {
        "action": "findTool",
        "query": "adverse event {{compound_name}} {{drug_class}}"
      }
    ],
    "molecular_profiler": [
      {
        "action": "findTool",
        "query": "compound properties {{compound_name}}"
      },
      {
        "action": "findTool",
        "query": "bioactivity {{compound_name}}"
      }
    ],
    "literature_reviewer": [
      {
        "action": "executeTool",
        "tool_name": "PubMed_search_articles",
        "arguments": {
          "query": "{{indication}} {{drug_class}}",
          "limit": 10
        }
      },
      {
        "action": "executeTool",
        "tool_name": "SemanticScholar_search_papers",
        "arguments": {
          "query": "{{indication}} {{drug_class}} {{compound_name}}",
          "limit": 10,
          "include_abstract": true
        }
      },
      {
        "action": "executeTool",
        "tool_name": "EuropePMC_search_articles",
        "arguments": {
          "query": "{{indication}} {{drug_class}} {{compound_name}}",
          "limit": 6
        }
      },
      {
        "action": "executeTool",
        "tool_name": "scrape_target",
        "optional": true,
        "arguments": {
          "target": "elife",
          "params": {
            "article_id": "{{elife_article_id}}"
          }
        }
      }
    ],
    "competitive_intel_analyst": [
      {
        "action": "executeTool",
        "tool_name": "search_clinical_trials",
        "arguments": {
          "query_term": "{{indication}} {{drug_class}}",
          "condition": "{{indication}}",
          "pageSize": 10
        }
      },
      {
        "action": "executeTool",
        "tool_name": "ctgov_stopped_trials",
        "optional": true,
        "arguments": {
          "condition": "{{indication}}",
          "pageSize": 8
        }
      },
      {
        "action": "executeTool",
        "tool_name": "SemanticScholar_search_papers",
        "arguments": {
          "query": "{{indication}} {{drug_class}} clinical landscape",
          "limit": 6,
          "include_abstract": true
        }
      },
      {
        "action": "findTool",
        "query": "target {{indication}}"
      }
    ]
  }
}
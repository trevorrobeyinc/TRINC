{
  "schema_version": "tool-prefetch-map-v2",
  "role_mappings": {
    "scout": [
      {
        "action": "executeTool",
        "tool_name": "PubMed_search_articles",
        "arguments": {
          "query": "{{therapeutic_area}} {{indication}} {{compound_name}}",
          "limit": 8
        }
      },
      {
        "action": "executeTool",
        "tool_name": "SemanticScholar_search_papers",
        "arguments": {
          "query": "{{therapeutic_area}} {{indication}} {{compound_name}}",
          "limit": 8,
          "include_abstract": true
        }
      },
      {
        "action": "executeTool",
        "tool_name": "search_clinical_trials",
        "arguments": {
          "query_term": "{{therapeutic_area}} {{indication}} {{compound_name}}",
          "condition": "{{indication}}",
          "pageSize": 8
        }
      },
      {
        "action": "executeTool",
        "tool_name": "ctgov_stopped_trials",
        "optional": true,
        "arguments": {
          "condition": "{{indication}}",
          "disease_context": "{{disease_context}}",
          "disease_name": "{{disease_name}}",
          "therapeutic_area": "{{therapeutic_area}}",
          "pageSize": 6
        },
        "_comment": "Stop-reason archaeology -> deliverables/graveyard-memo.md. All four condition aliases are passed because each workflow template names the indication differently; tool-prefetch drops the empty ones and the fetcher takes the first non-empty. Binding only {{indication}} silently skipped this source on 5 of 6 templates (fixed 2026-07-24)."
      },
      {
        "action": "executeTool",
        "tool_name": "OpenTargets_get_drug_id_description_by_name",
        "arguments": {
          "drugName": "{{compound_name}}"
        }
      },
      {
        "action": "executeTool",
        "tool_name": "obsidian_prior_research",
        "optional": true,
        "_comment": "Vault read-back via the canonical :8798 bridge. optional+fail-soft: when Obsidian is closed (e.g. run-workflow.js launched standalone) this yields nothing and the run proceeds with no prior-vault context.",
        "arguments": {
          "topic": "{{therapeutic_area}} {{indication}} {{compound_name}}",
          "limit": 5
        }
      },
      {
        "action": "executeTool",
        "tool_name": "opentargets_disease_intel",
        "optional": true,
        "_comment": "Open Targets Platform (GraphQL) disease lens. Returns ChEMBL-grounded in-clinic drug candidates + top associated targets, so its evidence raises the grounded-citation ratio rather than only adding prose. Fail-soft: any GraphQL/network error yields [] and the run continues.",
        "arguments": {
          "indication": "{{indication}}",
          "disease_name": "{{disease_name}}",
          "disease_context": "{{disease_context}}",
          "therapeutic_area": "{{therapeutic_area}}",
          "limit": 6
        }
      }
    ],
    "analyst": [
      {
        "action": "executeTool",
        "tool_name": "EuropePMC_search_articles",
        "arguments": {
          "query": "{{compound_name}} {{indication}} mechanism",
          "limit": 6
        }
      },
      {
        "action": "executeTool",
        "tool_name": "SemanticScholar_search_papers",
        "arguments": {
          "query": "{{compound_name}} {{indication}} mechanism",
          "limit": 6,
          "include_abstract": true
        }
      },
      {
        "action": "executeTool",
        "tool_name": "FAERS_search_reports_by_drug_and_indication",
        "arguments": {
          "medicinalproduct": "{{compound_name}}",
          "drugindication": "{{indication}}",
          "limit": 5
        }
      },
      {
        "action": "executeTool",
        "tool_name": "search_clinical_trials",
        "arguments": {
          "query_term": "{{compound_name}} {{indication}} endpoints",
          "intervention": "{{compound_name}}",
          "pageSize": 6
        }
      },
      {
        "action": "executeTool",
        "tool_name": "obsidian_prior_research",
        "optional": true,
        "_comment": "Vault read-back via the canonical :8798 bridge. optional+fail-soft: when Obsidian is closed (e.g. run-workflow.js launched standalone) this yields nothing and the run proceeds with no prior-vault context. READ-ONLY — Command Center's autoGenerateNotes owns vault writes.",
        "arguments": {
          "topic": "{{compound_name}} {{indication}} mechanism",
          "limit": 5
        }
      }
    ],
    "synthesizer": [
      {
        "action": "executeTool",
        "tool_name": "PubMed_search_articles",
        "arguments": {
          "query": "{{therapeutic_area}} review {{indication}}",
          "limit": 5
        }
      }
    ],
    "safety_signal_detector": [
      {
        "action": "executeTool",
        "tool_name": "FAERS_search_reports_by_drug_and_indication",
        "arguments": {
          "medicinalproduct": "{{compound_name}}",
          "drugindication": "{{indication}}",
          "limit": 8
        }
      },
      {
        "action": "findTool",
        "query": "adverse event {{compound_name}} {{drug_class}}"
      }
    ],
    "molecular_profiler": [
      {
        "action": "findTool",
        "query": "compound properties {{compound_name}}"
      },
      {
        "action": "findTool",
        "query": "bioactivity {{compound_name}}"
      },
      {
        "action": "executeTool",
        "tool_name": "opentargets_target_intel",
        "optional": true,
        "_comment": "Open Targets Platform (GraphQL) target lens: clinical candidates (ChEMBL-grounded), top disease associations, and recent literature (PMID-grounded). Only resolves when the template supplies target_gene; otherwise returns an honest zero.",
        "arguments": {
          "target": "{{target_gene}}",
          "limit": 8
        }
      },
      {
        "action": "executeTool",
        "tool_name": "opentargets_disease_intel",
        "optional": true,
        "_comment": "Open Targets Platform (GraphQL) disease lens. Returns ChEMBL-grounded in-clinic drug candidates + top associated targets, so its evidence raises the grounded-citation ratio rather than only adding prose. Fail-soft: any GraphQL/network error yields [] and the run continues.",
        "arguments": {
          "indication": "{{indication}}",
          "disease_name": "{{disease_name}}",
          "disease_context": "{{disease_context}}",
          "therapeutic_area": "{{therapeutic_area}}",
          "limit": 6
        }
      }
    ],
    "literature_reviewer": [
      {
        "action": "executeTool",
        "tool_name": "PubMed_search_articles",
        "arguments": {
          "query": "{{indication}} {{drug_class}}",
          "limit": 10
        }
      },
      {
        "action": "executeTool",
        "tool_name": "SemanticScholar_search_papers",
        "arguments": {
          "query": "{{indication}} {{drug_class}} {{compound_name}}",
          "limit": 10,
          "include_abstract": true
        }
      },
      {
        "action": "executeTool",
        "tool_name": "EuropePMC_search_articles",
        "arguments": {
          "query": "{{indication}} {{drug_class}} {{compound_name}}",
          "limit": 6
        }
      },
      {
        "action": "executeTool",
        "tool_name": "scrape_target",
        "optional": true,
        "arguments": {
          "target": "elife",
          "params": {
            "article_id": "{{elife_article_id}}"
          }
        }
      },
      {
        "action": "executeTool",
        "tool_name": "obsidian_prior_research",
        "optional": true,
        "_comment": "Vault read-back via the canonical :8798 bridge. optional+fail-soft: when Obsidian is closed (e.g. run-workflow.js launched standalone) this yields nothing and the run proceeds with no prior-vault context. READ-ONLY — Command Center's autoGenerateNotes owns vault writes.",
        "arguments": {
          "topic": "{{indication}} {{drug_class}} {{compound_name}}",
          "limit": 5
        }
      }
    ],
    "competitive_intel_analyst": [
      {
        "action": "executeTool",
        "tool_name": "search_clinical_trials",
        "arguments": {
          "query_term": "{{indication}} {{drug_class}}",
          "condition": "{{indication}}",
          "pageSize": 10
        }
      },
      {
        "action": "executeTool",
        "tool_name": "ctgov_stopped_trials",
        "optional": true,
        "arguments": {
          "condition": "{{indication}}",
          "disease_context": "{{disease_context}}",
          "disease_name": "{{disease_name}}",
          "therapeutic_area": "{{therapeutic_area}}",
          "pageSize": 8
        },
        "_comment": "Stop-reason archaeology -> deliverables/graveyard-memo.md. All four condition aliases are passed because each workflow template names the indication differently; tool-prefetch drops the empty ones and the fetcher takes the first non-empty. Binding only {{indication}} silently skipped this source on 5 of 6 templates (fixed 2026-07-24)."
      },
      {
        "action": "executeTool",
        "tool_name": "SemanticScholar_search_papers",
        "arguments": {
          "query": "{{indication}} {{drug_class}} clinical landscape",
          "limit": 6,
          "include_abstract": true
        }
      },
      {
        "action": "findTool",
        "query": "target {{indication}}"
      },
      {
        "action": "executeTool",
        "tool_name": "opentargets_disease_intel",
        "optional": true,
        "_comment": "Open Targets Platform (GraphQL) disease lens. Returns ChEMBL-grounded in-clinic drug candidates + top associated targets, so its evidence raises the grounded-citation ratio rather than only adding prose. Fail-soft: any GraphQL/network error yields [] and the run continues.",
        "arguments": {
          "indication": "{{indication}}",
          "disease_name": "{{disease_name}}",
          "disease_context": "{{disease_context}}",
          "therapeutic_area": "{{therapeutic_area}}",
          "limit": 8
        }
      },
      {
        "action": "executeTool",
        "tool_name": "obsidian_prior_research",
        "optional": true,
        "_comment": "Vault read-back via the canonical :8798 bridge. optional+fail-soft: when Obsidian is closed (e.g. run-workflow.js launched standalone) this yields nothing and the run proceeds with no prior-vault context. READ-ONLY — Command Center's autoGenerateNotes owns vault writes.",
        "arguments": {
          "topic": "{{indication}} {{drug_class}} competitive landscape",
          "limit": 5
        }
      }
    ]
  }
}

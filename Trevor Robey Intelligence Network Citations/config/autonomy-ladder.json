{
  "schemaVersion": "phase15-autonomy-ladder-v1",
  "roles": {
    "orchestrator": {
      "allowedActions": ["plan_mission", "spawn_agents", "resume_mission", "synthesize_mission"],
      "requireHumanApproval": []
    },
    "scout": {
      "allowedActions": ["collect_sources", "execute_task", "discover_sources", "discover_tools"],
      "requireHumanApproval": ["execute_task"]
    },
    "analyst": {
      "allowedActions": ["analyze_documents", "execute_task", "extract_structured", "execute_tools"],
      "requireHumanApproval": ["execute_task"]
    },

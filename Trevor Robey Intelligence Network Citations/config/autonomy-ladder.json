    },
    "literature_reviewer": {
      "allowedActions": ["collect_sources", "execute_task", "discover_sources", "extract_structured"],
      "requireHumanApproval": ["execute_task"]
    },
    "safety_signal_detector": {
      "allowedActions": ["analyze_documents", "execute_task", "extract_structured", "execute_tools"],
      "requireHumanApproval": ["execute_task"]
    },
    "molecular_profiler": {
      "allowedActions": ["analyze_documents", "execute_task", "extract_structured", "execute_tools"],
      "requireHumanApproval": ["execute_task"]
    },
    "competitive_intel_analyst": {
      "allowedActions": ["analyze_documents", "execute_task", "extract_structured", "execute_tools"],
      "requireHumanApproval": ["execute_task"]
    },
    "quality_auditor": {
      "allowedActions": ["analyze_documents", "execute_task", "extract_structured", "execute_tools"],
      "requireHumanApproval": ["execute_task"]
    },
    "report_generator": {
      "allowedActions": ["synthesize_output", "execute_task", "build_dataset_rows", "write_dataset_card"],
      "requireHumanApproval": ["execute_task"]
    }
  }

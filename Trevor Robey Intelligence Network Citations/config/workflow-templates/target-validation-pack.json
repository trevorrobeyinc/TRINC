{
  "schema_version": "phase30-workflow-v1",
  "workflow_template_id": "target-validation-pack",
  "name": "Target Validation Intelligence Pack",
  "description": "Target validation, pathway analysis, and PPI network mapping using OpenTargets, UniProt, HPA, and InterPro via ToolUniverse.",
  "auto_approve": true,
  "provider_preference": {
    "primary": "claude-code"
  },
  "input_schema": {
    "required": ["target_gene"],
    "properties": {
      "target_gene": { "type": "string", "description": "Gene symbol or protein target to validate" },
      "disease_context": { "type": "string", "description": "Disease context for target validation" },
      "input_dir": { "type": "string", "description": "Path to seed documents directory", "default": "workspace/research-input/biomedical/" }
    }
  },
  "pipeline": [
    {
      "step_id": "research",
      "type": "mission",
      "mission_template_id": "biomedical_target_identification",
      "description_template": "Target validation for {{target_gene}} in {{disease_context}}",
      "mission_type": "research_to_dataset",
      "dataset_type": "retrieval_qa"
    },
    {
      "step_id": "quality_check",
      "type": "quality_audit",
      "depends_on": ["research"],
      "confidence_threshold": 0.7,
      "verification_tools": ["OpenTargets", "UniProt", "HPA", "InterPro"]
    },
    {
      "step_id": "build_dataset",
      "type": "dataset",
      "depends_on": ["quality_check"],
      "dataset_type": "retrieval_qa",
      "quality_threshold": 0.6
    },
    {
      "step_id": "package",
      "type": "offer",
      "depends_on": ["build_dataset"],
      "product_line": "biomedical_dataset_packs",
      "tier": "premium",
      "targets": ["datarade"]
    },
    {
      "step_id": "approve",
      "type": "approve",
      "depends_on": ["package"]
    },
    {
      "step_id": "export",
      "type": "export",
      "depends_on": ["approve"],
      "format": "zip"
    }
  ]
}

{
  "name": "obsidian-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "probe:miyo": "node dist/cli/miyoMcpProbe.js",
    "start:https": "node dist/index.js --transport=https",
    "start:uds": "node dist/index.js --transport=uds",
    "start:pipe": "node dist/index.js --transport=pipe",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "live:communication:cli": "node dist/tests/live/communication.cli.validation.js",
    "lint:transport": "if grep -nE 'http\\.createServer\\(|OPENCLAW_BRIDGE_TLS_DISABLE\\s*={2,3}|tlsDisable\\s*\\?' src/server/httpTransport.ts; then echo 'lint:transport FAILED: forbidden plaintext pattern in network transport. The :8798 bridge MUST be HTTPS-only.'; exit 1; else echo 'lint:transport OK'; fi"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/node": "^22.14.1",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}

{
  "name": "@trevoralexanderrobey/obsidian-bridge-adapter",
  "version": "0.6.0",
  "description": "Stdio MCP adapter that gives Claude one door into Obsidian: a closed set of tools proxied over HTTPS to the Command Center (:8799) and Viz Studio (:8800) plugin bridges.",
  "type": "module",
  "main": "index.mjs",
  "bin": {
    "obsidian-bridge-adapter": "./index.mjs"
  },
  "scripts": {
    "start:openclaw": "OBSIDIAN_STDIO_PROFILE=openclaw node index.mjs",
    "test:profiles": "node scripts/test-profiles.mjs"
  },
  "files": [
    "index.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "obsidian-bridge",
    "obsidian-local-rest-api",
    "stdio",
    "adapter",
    "bridge",
    "mcp-server"
  ],
  "license": "MIT",
  "author": "Trevor Robey <trevor@trevorobeyinc.com>",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}

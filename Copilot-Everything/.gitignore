# ─────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js
.yarn/

# ─────────────────────────────────────────────
# Build outputs
# ─────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ─────────────────────────────────────────────
# Runtime / state / logs
# ─────────────────────────────────────────────
state/
# The broad `state/` rule above (runtime state dirs) was silently swallowing the
# vendored Copilot fork's UPSTREAM source dir
# `repos/obsidian-copilot-mcp/src/state/` (ChatUIState.ts, vaultDataAtoms.ts),
# which broke `npm run build` (TS2307: cannot find module @/state/*).
# Re-include that source directory explicitly.
!repos/obsidian-copilot-mcp/src/state/
!repos/obsidian-copilot-mcp/src/state/**
logs/
*.log
*.pid
.pm2/

# ─────────────────────────────────────────────
# Secrets & local-only config
#   (any *.local.json typically holds tokens)
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.local.json
!example*.local.json

# Bridge auth + cert files
**/obsidian-cli-mcp.local.json
**/raycast-obsidian-mcp.local.json
**/*.pem
**/*.key
**/*.crt

# Claude Code local settings
.claude/settings.local.json
**/.claude/settings.local.json

# ─────────────────────────────────────────────
# Backup / cleanup artifacts
# ─────────────────────────────────────────────
*.bak
*.bak.*
*.cleanup.*
*.orig
*~

# ─────────────────────────────────────────────
# Validation / scratch / temp output
# ─────────────────────────────────────────────
configs/validation/
deploy/backups/
tasks/.cache/
tmp/
.tmp/

# ─────────────────────────────────────────────
# Editor / OS
# ─────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# ─────────────────────────────────────────────
# Test artifacts
# ─────────────────────────────────────────────
coverage/
.nyc_output/
test-results/

# ─────────────────────────────────────────────
# Personal side-repos passthrough (added 2026-08-18)
#   Copilot-Everything/Code is a SYMLINK to /Users/myhome/Code — the real,
#   canonical home of the independent side-repos (Obsidian Clipper,
#   obsidian-auto-wiki-summarize, whisper-transcriber, TR-Portfolio,
#   trevorrobeyinc.github.io, Scripts). They are separate git repos and must
#   never be tracked by the monorepo — ignore the link itself.
# ─────────────────────────────────────────────
/Code

# Captured vault-settings snapshots contain real userId / license key / encrypted
# (enc_desk_) secrets — never track the settings file (audit CS-3).
repos/.upstream-*-vault-snapshot/data.json

# Same rule for the dev-lane runtime bundle staged under deploy/: its data.json is
# Obsidian-WRITTEN runtime settings (dev-build.sh deliberately preserves it across
# rebuilds) carrying the full secret-slot schema — a latent plaintext-in-git vector
# (2026-07 API-key-storage audit, pending item 3). Untracked 2026-07-31; file stays
# on disk for the dev vault.
deploy/obsidian/plugins/*/data.json
# repos/obsidian-copilot-mcp/   # vendored into monorepo 2026-05-07; see repos/obsidian-copilot-mcp/UPSTREAM.md

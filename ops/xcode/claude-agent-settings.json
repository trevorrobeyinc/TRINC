{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableClaudeAiConnectors": true,
  "syncClaudeAiPlugins": false,
  "enableAllProjectMcpServers": false,
  "disabledMcpjsonServers": [
    "openclaw-obsidian",
    "perseus-business",
    "perseus-vault",
    "searxng-search",
    "trinc-content",
    "zettelkasten-graph"
  ],
  "autoUploadSessions": false,
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/Library/Keychains/**)",
      "Edit(~/Library/Keychains/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.mcp-auth/**)",
      "Read(~/.config/trevclaw/**)",
      "Read(~/.perseus-vault/**)",
      "Edit(~/.perseus-vault/**)",
      "Read(~/Library/Application Support/mkcert/**)",
      "Read(~/.local/share/mkcert/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.key)",
      "Read(~/.claude.json)",
      "Edit(~/.claude.json)",
      "Edit(~/.claude/**)",
      "Read(~/Library/Developer/Xcode/CodingAssistant/ClaudeAgentConfig/.claude.json)",
      "Edit(~/Library/Developer/Xcode/CodingAssistant/**)",
      "Edit(~/Library/Preferences/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/.local/bin/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Edit(~/Security Everything/**)",
      "Read(~/Security Everything/secrets/**)",
      "Edit(~/TRINC/ops/xcode/**)",
      "Edit(~/TRINC/ops/tr-suite/**)",
      "Edit(~/TRINC/.mcp.json)",
      "Edit(~/TRINC/.claude/**)",
      "Edit(~/TrevClaw-Obsidianodus/ops/xcode/**)",
      "Edit(~/TrevClaw-Obsidianodus/ops/tr-suite/**)",
      "Bash(sudo:*)",
      "Bash(security:*)",
      "Bash(gpg:*)",
      "Bash(gpgconf:*)",
      "Bash(gpg-connect-agent:*)",
      "Bash(ssh-add:*)",
      "Bash(operator-approved-gate:*)",
      "Bash(operator-approve-gate:*)",
      "Bash(cb-gate:*)",
      "Bash(ccu-gate:*)",
      "Bash(sudo-gate:*)",
      "Bash(yk-session-gate:*)",
      "Bash(gmail-arm:*)",
      "Bash(gmail-mcp-seal:*)",
      "Bash(gh-mcp:*)",
      "Bash(fw:*)",
      "Bash(fw-seal:*)",
      "Bash(fw-armed-write:*)",
      "Bash(claude mcp:*)",
      "Bash(git push:*)",
      "Bash(launchctl:*)",
      "Bash(defaults write:*)",
      "Bash(defaults delete:*)",
      "Bash(plutil:*)",
      "Bash(xattr:*)",
      "Bash(spctl:*)",
      "Bash(csrutil:*)",
      "Bash(tccutil:*)",
      "mcp__openclaw-obsidian",
      "mcp__perseus-business",
      "mcp__perseus-vault",
      "mcp__trinc-content",
      "mcp__searxng-search",
      "mcp__zettelkasten-graph",
      "mcp__FilesystemPlus",
      "mcp__miyo"
    ]
  }
}

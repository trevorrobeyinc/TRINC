# =============================================================================
# TrevClaw-Obsidianodus monorepo .gitignore
# =============================================================================
# This is the single root .gitignore. Per-package .gitignore files are also
# honored downstream; this file holds the shared baseline.

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn-integrity

# Python
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/

# -----------------------------------------------------------------------------
# Build outputs
# -----------------------------------------------------------------------------
dist/
build/
out/
target/
.next/
.nuxt/
.turbo/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Test artifacts
# -----------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.nyc_output/
coverage/
junit.xml

# -----------------------------------------------------------------------------
# Logs & runtime
# -----------------------------------------------------------------------------
*.log
*.pid
*.seed
*.pid.lock
.pm2/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Secrets — NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
# Allow templates: .env.example, .env.template, .env.sample
!.env.example
!.env.template
!.env.sample

# Certificates and keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
secrets.json
credentials.json

# -----------------------------------------------------------------------------
# IDEs and editors
# -----------------------------------------------------------------------------
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath

# -----------------------------------------------------------------------------
# Local archive / scratch
# -----------------------------------------------------------------------------
.archive/
.scratch/
tmp/
temp/

# -----------------------------------------------------------------------------
# CI cache (per repo policy: never commit npm/pip cache content)
# -----------------------------------------------------------------------------
.ci/npm-cache/
.ci/pip-cache/
.cache/

# -----------------------------------------------------------------------------
# Workspace runtime state — trevor-robey-inc-agents biomedical workflow
# -----------------------------------------------------------------------------
# Run-time logs and large transient artifacts; keep deliberate content.
trevor-robey-inc-agents/state/
trevor-robey-inc-agents/workspace/audit/live-run-*.stdout
trevor-robey-inc-agents/workspace/audit/live-run-*.stderr
trevor-robey-inc-agents/workspace/runtime/cache/
trevor-robey-inc-agents/workspace/research-raw/
trevor-robey-inc-agents/workspace/research-output/_tmp/

# -----------------------------------------------------------------------------
# Validation gate run logs (Copilot-Everything)
# -----------------------------------------------------------------------------
Copilot-Everything/configs/validation/cli-stability-gate-*/
Copilot-Everything/configs/validation/*-nohup.log

# -----------------------------------------------------------------------------
# Large binaries — keep out of git, use external storage / submodules / LFS
# -----------------------------------------------------------------------------
*.gguf
*.safetensors
*.h5
*.parquet
*.npz
*.pkl
# Allow small bundled fixtures up to ~5MB by NOT excluding *.bin globally;
# add specific paths if needed.

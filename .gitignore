# =============================================================================
# TrevClaw-Obsidianodus monorepo .gitignore
# =============================================================================
# This is the single root .gitignore. Per-package .gitignore files are also
# honored downstream; this file holds the shared baseline.

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn-integrity

# Python
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/

# -----------------------------------------------------------------------------
# Build outputs
# -----------------------------------------------------------------------------
dist/
build/
out/
target/
.next/
.nuxt/
.turbo/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Test artifacts
# -----------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.nyc_output/
coverage/
junit.xml

# -----------------------------------------------------------------------------
# Logs & runtime
# -----------------------------------------------------------------------------
*.log
*.pid
*.seed
*.pid.lock
.pm2/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Secrets — NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
# Allow templates: .env.example, .env.template, .env.sample
!.env.example
!.env.template
!.env.sample

# Certificates and keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
secrets.json
credentials.json

# -----------------------------------------------------------------------------
# IDEs and editors
# -----------------------------------------------------------------------------
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Claude Code per-machine local overrides — permissions allowlist, enabled MCP
# servers, etc. Machine-specific, not shared. (The shared .claude/settings.json,
# agents, and skills stay tracked; only the *.local.json override is ignored.)
# -----------------------------------------------------------------------------
.claude/settings.local.json
.project
.classpath

# -----------------------------------------------------------------------------
# Local archive / scratch
# -----------------------------------------------------------------------------
.archive/
.scratch/
tmp/
temp/

# -----------------------------------------------------------------------------
# CI cache (per repo policy: never commit npm/pip cache content)
# -----------------------------------------------------------------------------
.ci/npm-cache/
.ci/pip-cache/
.cache/

# -----------------------------------------------------------------------------
# Workspace runtime state — biomedical workflow engine
# (folder flat-merged 2026-05-19: trevor-robey-inc-agents/ ->
#  "Trevor Robey Intelligence Network Citations/")
# -----------------------------------------------------------------------------
# Run-time logs and large transient artifacts; keep deliberate content.
Trevor Robey Intelligence Network Citations/state/
Trevor Robey Intelligence Network Citations/workspace/audit/live-run-*.stdout
Trevor Robey Intelligence Network Citations/workspace/audit/live-run-*.stderr
Trevor Robey Intelligence Network Citations/workspace/runtime/cache/
Trevor Robey Intelligence Network Citations/workspace/research-raw/
Trevor Robey Intelligence Network Citations/workspace/research-output/_tmp/
# Research-API payload logs (may contain unredacted request/response bodies)
Trevor Robey Intelligence Network Citations/workspace/api-contracts/

# -----------------------------------------------------------------------------
# Validation gate run logs (Copilot-Everything)
# -----------------------------------------------------------------------------
Copilot-Everything/configs/validation/cli-stability-gate-*/
Copilot-Everything/configs/validation/*-nohup.log

# -----------------------------------------------------------------------------
# Large binaries — keep out of git, use external storage / submodules / LFS
# -----------------------------------------------------------------------------
*.gguf
*.safetensors
*.h5
*.parquet
*.npz
*.pkl
# Allow small bundled fixtures up to ~5MB by NOT excluding *.bin globally;
# add specific paths if needed.

# -----------------------------------------------------------------------------
# Self-Evolving skill — per-workspace memory (private friction logs, not shared)
# Resolved per .claude/skills/self-evolving/SKILL.md "Memory Path Resolution":
# matches at monorepo root and inside any sub-workspace (Claude/,
# Copilot-Everything/, trevor-robey-inc-agents/, trevor-robey-inc/).
# -----------------------------------------------------------------------------
.self-evolving/

# -----------------------------------------------------------------------------
# cc-bridge-monitor runtime heartbeat state (churns every monitor tick — noise)
# -----------------------------------------------------------------------------
Claude/.logs/.cc-bridge-last-state
Claude/.logs/cc-bridge-monitor.events.jsonl

# -----------------------------------------------------------------------------
# Unrelated migrated project — "PVA Mobility Equipment Loan Closet" (AppSheet
# prototype). Its contents were copied out to trevorrobeyinc/trevorrobeyinc.github.io;
# this loose local copy does not belong in the biomedical monorepo. MOVED OUT to
# ~/Code/pva-loan-closet on 2026-10-21 (personal project, kept beside TR-Portfolio).
# The ignore stays so a stray copy can never be committed here by accident.
# -----------------------------------------------------------------------------
/pva-loan-closet/

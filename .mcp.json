{
  "mcpServers": {
    "searxng-search": {
      "command": "/Users/myhome/.nvm/versions/node/v22.13.1/bin/node",
      "args": [
        "/Users/myhome/.claude/mcp-servers/searxng-search/src/server.js"
      ],
      "env": {
        "SEARXNG_BASE_URL": "https://127.0.0.1:8891",
        "NODE_EXTRA_CA_CERTS": "/Users/myhome/Library/Application Support/mkcert/rootCA.pem"
      }
    },
    "perseus-business": {
      "command": "/Users/myhome/.local/bin/perseus-vault",
      "args": [
        "serve",
        "--db",
        "/Users/myhome/.perseus-vault/data/business-vault.db",
        "--encryption-key",
        "/Users/myhome/.perseus-vault/business.key",
        "--embedding-model",
        "/Users/myhome/.perseus-vault/models/model.onnx"
      ],
      "env": {
        "PATH": "/Users/myhome/.perseus-vault/embed-venv/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    },
    "trinc-content": {
      "type": "stdio",
      "command": "/Users/myhome/.nvm/versions/node/v22.13.1/bin/node",
      "args": [
        "/Users/myhome/.claude/mcp-servers/trinc-content/src/server.js"
      ],
      "env": {
        "TRINC_CONTENT_REPO": "/Users/myhome/TrevClaw-Obsidianodus",
        "TRINC_CONTENT_PUBLISH": ""
      }
    },
    "opencode": {
      "type": "stdio",
      "command": "/Users/myhome/.claude/mcp-servers/opencode-mcp/.venv/bin/python",
      "args": [
        "/Users/myhome/.claude/mcp-servers/opencode-mcp/server.py"
      ],
      "env": {
        "OPENCODE_MCP_BIN": "/opt/homebrew/bin/opencode",
        "OPENCODE_MCP_MODEL": "opencode/deepseek-v4-flash-free",
        "OPENCODE_CONFIG": "/Users/myhome/.config/opencode/delegation-guardrail.json",
        "OPENCODE_MCP_ALLOWED_DIRS": "/Users/myhome/TrevClaw-Obsidianodus"
      }
    }
  }
}

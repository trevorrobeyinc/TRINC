        "/Users/myhome/.perseus-vault/business.key",
        "--embedding-model",
        "/Users/myhome/.perseus-vault/models/model.onnx"
      ],
      "env": {
        "PATH": "/Users/myhome/.perseus-vault/embed-venv/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    },
    "trinc-content": {
      "type": "stdio",

#!/usr/bin/env bash
set -euo pipefail

LOGS_DIR="$HOME/Claude/.logs"
PLISTS_DST="$HOME/Library/LaunchAgents"
MKCERT_CA="$HOME/Library/Application Support/mkcert/rootCA.pem"

# In-monorepo HTTPS TLS proxies (launchd-owned; staged + installed via
# Copilot-Everything/scripts/install-tls-proxies.sh). Loopback services are
# reached ONLY through these proxies, never their plaintext upstreams.
# Format: "<launchd-unit>:<proxy-port>:<upstream-port>:<label>"
TLS_PROXIES=(
  "com.trevorrobey.miyo-tls-proxy:8743:8742:Miyo"
  "com.trevorrobey.qdrant-tls-proxy:6433:6333:Qdrant"
)

# Services we manage. Gateway/bridge/MCP are pre-existing.
MANAGED_SERVICES=(
  "com.trevorrobey.cc-bridge-monitor"
)

# All services we monitor (cc-bridge-monitor + the four launchd TLS proxies)
ALL_SERVICES=(
  "com.trevorrobey.cc-bridge-monitor"
  "com.trevorrobey.miyo-tls-proxy"
  "com.trevorrobey.qdrant-tls-proxy"
)

cmd_start() {
  for svc in "${MANAGED_SERVICES[@]}"; do
    if launchctl list 2>/dev/null | grep -q "$svc"; then
      echo "  already loaded: $svc"
    else
      launchctl load "$PLISTS_DST/$svc.plist" 2>/dev/null && echo "  loaded: $svc" || echo "  FAILED: $svc"
    fi
  done
}

cmd_stop() {
  for svc in "${MANAGED_SERVICES[@]}"; do
    launchctl unload "$PLISTS_DST/$svc.plist" 2>/dev/null && echo "  unloaded: $svc" || echo "  (not loaded): $svc"
  done
}

cmd_status() {
  printf "%-48s %-8s %-15s\n" "SERVICE" "PID" "STATUS"
  printf "%-48s %-8s %-15s\n" "-------" "---" "------"
  for svc in "${ALL_SERVICES[@]}"; do
    line=$(launchctl list 2>/dev/null | grep "$svc" || echo "")
    if [ -z "$line" ]; then
      printf "%-48s %-8s %-15s\n" "$svc" "-" "not loaded"
    else
      pid=$(echo "$line" | awk '{print $1}')
      exit_code=$(echo "$line" | awk '{print $2}')
      if [ "$pid" != "-" ] && [ -n "$pid" ]; then
        printf "%-48s %-8s %-15s\n" "$svc" "$pid" "running"
      elif [ "$exit_code" != "0" ] && [ -n "$exit_code" ]; then
        printf "%-48s %-8s %-15s\n" "$svc" "-" "crashed (exit=$exit_code)"
      else
        printf "%-48s %-8s %-15s\n" "$svc" "-" "stopped"
      fi
    fi
  done

  # Also show Obsidian-dependent services
  echo ""
  printf "%-48s %-8s %-15s\n" "Obsidian (CC bridge :8799)" \
    "$(pgrep -x Obsidian 2>/dev/null || echo '-')" \
    "$(pgrep -x Obsidian > /dev/null 2>&1 && echo 'running' || echo 'not running')"
  printf "%-48s %-8s %-15s\n" "Miyo.app (upstream behind :8743 proxy)" \
    "$(pgrep -x Miyo 2>/dev/null | head -1 || echo '-')" \
    "$(pgrep -x Miyo > /dev/null 2>&1 && echo 'running' || echo 'not running')"
}

cmd_health() {
  echo "TLS proxies (HTTPS terminators → plaintext upstream):"
  for entry in "${TLS_PROXIES[@]}"; do
    IFS=':' read -r _unit pport uport name <<< "$entry"
    code=$(curl -s -o /dev/null -w "%{http_code}" -m 3 --cacert "$MKCERT_CA" "https://127.0.0.1:$pport/" 2>/dev/null || echo "000")
    if [ "$code" != "000" ]; then
      printf "  %-10s :%-6s up (TLS ok; upstream :%s)\n" "$name" "$pport" "$uport"
    else
      printf "  %-10s :%-6s DOWN (proxy not listening / TLS fail) — run install-tls-proxies.sh\n" "$name" "$pport"
    fi
  done
  echo ""

  echo "Miyo semantic search (via :8743 proxy → :8742):"
  if miyo_resp=$(curl -s -m 3 --cacert "$MKCERT_CA" https://127.0.0.1:8743/v0/health 2>/dev/null); then
    echo "$miyo_resp" | python3 -m json.tool 2>/dev/null || echo "  responding"
  else
    echo "  unreachable via :8743 (check the proxy unit in 'openclaw-stack status'; Miyo.app may be closed)"
  fi
  echo ""

  echo "CC Bridge (:8799, HTTPS):"
  if bridge_resp=$(curl -s -m 3 --cacert "$MKCERT_CA" https://127.0.0.1:8799/health 2>/dev/null); then
    echo "$bridge_resp" | python3 -m json.tool 2>/dev/null || echo "  responding"
  else
    echo "  unreachable (Obsidian may be closed)"
  fi
}

cmd_logs() {
  local svc="${1:-}"
  case "$svc" in
    monitor)     tail -f "$LOGS_DIR/cc-bridge-monitor.out.log" "$LOGS_DIR/cc-bridge-monitor.events.jsonl" ;;
    *) echo "Usage: openclaw-stack logs monitor"; exit 1 ;;
  esac
}

cmd_errors() {
  echo "=== Recent errors ==="
  for log in "$LOGS_DIR"/*.err.log; do
    [ -s "$log" ] || continue
    echo ""
    echo "--- $(basename "$log") ---"
    tail -20 "$log"
  done
  if [ -f "$LOGS_DIR/cc-bridge-monitor.events.jsonl" ]; then
    errors=$(grep '"level":"error"' "$LOGS_DIR/cc-bridge-monitor.events.jsonl" 2>/dev/null | tail -5)
    if [ -n "$errors" ]; then
      echo ""
      echo "--- monitor events (errors) ---"
      echo "$errors"
    fi
  fi
}

cmd_events() {
  local svc="${1:-monitor}"
  local logfile="$LOGS_DIR/cc-bridge-monitor.events.jsonl"
  if [ ! -f "$logfile" ]; then
    echo "No events log found at $logfile"
    exit 1
  fi
  tail -f "$logfile" | python3 -c "
import json, sys
for line in sys.stdin:
    try:
        e = json.loads(line)
        colors = {'info': '\033[36m', 'warn': '\033[33m', 'error': '\033[31m'}
        c = colors.get(e.get('level',''), '')
        print(f\"{c}[{e['timestamp']}] {e['level'].upper()} {e['event']}\033[0m {e.get('detail') or ''}\")
    except:
        print(line.strip())
  "
}

cmd_verify() {
  echo "=== OpenClaw Stack Verification ==="
  echo ""
  cmd_status
  echo ""
  cmd_health
  echo ""
  cmd_errors
}

case "${1:-}" in
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_stop; sleep 2; cmd_start ;;
  status)    cmd_status ;;
  health)    cmd_health ;;
  logs)      cmd_logs "${2:-}" ;;
  errors)    cmd_errors ;;
  events)    cmd_events "${2:-}" ;;
  verify)    cmd_verify ;;
  *)
    echo "Usage: openclaw-stack {start|stop|restart|status|health|logs|errors|events|verify}"
    echo ""
    echo "  start     Load monitor plist"
    echo "  stop      Unload managed plists"
    echo "  restart   Stop then start"
    echo "  status    Show all service statuses"
    echo "  health    Curl all health endpoints"
    echo "  logs      Tail logs (monitor)"
    echo "  errors    Show recent errors across all services"
    echo "  events    Tail structured event log with colors"
    echo "  verify    Full status + health + errors check"
    exit 1
    ;;
esac

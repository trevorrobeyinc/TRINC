{
  "schemaVersion": "biomedical-entities-v1",
  "entityPatterns": [
    { "type": "gene_symbol", "pattern": "^[A-Z][A-Z0-9]{1,5}$", "weight": 2.0, "examples": ["BRCA1", "TP53", "EGFR"] },
    { "type": "drug_id", "pattern": "^DB\\d{5}$", "weight": 2.0, "examples": ["DB00945", "DB01050"] },
    { "type": "pmid", "pattern": "^PMID:\\d+$", "weight": 1.5, "examples": ["PMID:12345678"] },
    { "type": "nct_id", "pattern": "^NCT\\d{8}$", "weight": 1.5, "examples": ["NCT01234567"] },
    { "type": "cid", "pattern": "^CID:\\d+$", "weight": 1.5, "examples": ["CID:2244"] },
    { "type": "uniprot", "pattern": "^[A-Z][0-9][A-Z0-9]{3}[0-9]$", "weight": 2.0, "examples": ["P04637", "Q9Y6K1"] }
  ],
  "preservePatterns": [
    "drug interaction",
    "adverse effect",
    "mechanism of action",
    "clinical trial",
    "side effect",
    "half life",
    "blood brain barrier",
    "cytochrome p450",
    "protein protein interaction",
    "gene expression"
  ],
  "weightMultipliers": {
    "gene_symbol": 2.0,
    "drug_name": 1.8,
    "disease_name": 1.5,
    "pathway_name": 1.5,
    "default": 1.0
  }
}

{
  "name": "obsidian-bridge-launcher",
  "version": "0.1.1",
  "description": "Spawns the canonical Obsidian MCP bridge as a child process tied to Obsidian's lifecycle",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy": "npm run build && node deploy.mjs",
    "lint:transport": "bash ../../scripts/lint-transport-monorepo.sh --strict"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0"
  }
}

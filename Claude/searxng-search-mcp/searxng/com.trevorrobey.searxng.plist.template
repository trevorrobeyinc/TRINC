<?xml version="1.0" encoding="UTF-8"?>
<!--
  Boot-persistent launchd unit for the private SearXNG instance.
  __HOME__ is substituted with the real home path by install-service.sh.
  ALL paths resolve to the INTERNAL volume (~/.local/share, ~/.config) — a launchd
  user-agent cannot read the external /Volumes/ExtraCurricular volume (TCC EPERM).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trevorrobey.searxng</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/share/searxng/venv/bin/python</string>
        <string>-m</string>
        <string>searx.webapp</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/.local/share/searxng/searxng-src</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>SEARXNG_SETTINGS_PATH</key>
        <string>__HOME__/.config/searxng/settings.yml</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!--
      Standard, not Background (operator's go, 2026-11-15). Background put SearXNG in macOS's
      throttled band: scheduler priority 4, throttled disk and network I/O (setpriority(2)). On a
      loaded Mac the whole process stopped running: on 2026-11-15 every engine missed its 6-10 s
      deadline by about 48 s, all in the same second, and a restart spent 61 s loading. It answers
      while a caller waits (the searxng-search MCP, the business lane's web evidence), so it runs
      in the same class as the TLS proxy in front of it (no ProcessType, which is Standard).
    -->
    <key>ProcessType</key>
    <string>Standard</string>

    <key>StandardOutPath</key>
    <string>__HOME__/.local/share/searxng/searxng.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/share/searxng/searxng.log</string>
</dict>
</plist>
